# Branches
	jmp %1
%1:
=
%1:

	jmp %2
%1:
%2:
=
%1:
%2:

	jmp L%1
	jmp L%2
=
	jmp L%1

# Branches
	bra %1
%1:
=
%1:

	bra %2
%1:
%2:
=
%1:
%2:

	bra L%1
	bra L%2
=
	bra L%1

# Pop and transfer (this is ok as D is always invalidated
	ldd ,s++
	tfr d,x
=
	ldx ,s++

# Pop transfer and load (D and X will be invalidated so this is ok
	ldx ,s++
	ld%1 0,x
=
	ld%1 [,s++]

# Store 32bit optimisation
	exg d,y
	stb 1,x
	sta 0,x
	exg d,y
=
	sty 0,x

# -- handling that we don't clean up as a subtree (should move into
# compiler eventually)
# Can only partially fix this as for the ldx n,s cases the pshs d moves
# the stack pointer and offset changes
	ldx _%1
	ldd %2,x
	pshs d
	ldx _%1
	ldd %3,x
	lbsr __minus
=
	ldx _%1
	ldd %2,x
	subd %3,x

	ldx _%1
	ldd %2,x
	pshs d
	ldx _%4
	ldd %3,x
	lbsr __minus
=
	ldx _%1
	ldd %2,x
	ldx _%4
	subd %3,x
