# Sillies
	addd #%1
	addd #%2
=
	addd #%1+%2

# Pop and transfer (this is ok as D is always invalidated
	ldd ,s++
	tfr d,x
=
	ldx ,s++

# Pop transfer and load (D and X will be invalidated so this is ok
	ldx ,s++
	ld%1 0,x
=
	ld%1 [,s++]

# -- handling that we don't clean up as a subtree (should move into
# compiler eventually)
# Can only partially fix this as for the ldx n,s cases the pshs d moves
# the stack pointer and offset changes
	ldx _%1
	ldd %2,x
	pshs d
	ldx _%1
	ldd %3,x
	lbsr __minus
=
	ldx _%1
	ldd %2,x
	subd %3,x

	ldx _%1
	ldd %2,x
	pshs d
	ldx _%4
	ldd %3,x
	lbsr __minus
=
	ldx _%1
	ldd %2,x
	ldx _%4
	subd %3,x

# -- handling that we don't clean up as a subtree (should move into
# compiler eventually)
# Can only partially fix this as for the ldx n,s cases the pshs d moves
# the stack pointer and offset changes
	ldx _%1
	ldd %2,x
	pshs d
	ldx _%1
	ldd %3,x
	jsr __minus
=
	ldx _%1
	ldd %2,x
	subd %3,x

	ldx _%1
	ldd %2,x
	pshs d
	ldx _%4
	ldd %3,x
	jsr __minus
=
	ldx _%1
	ldd %2,x
	ldx _%4
	subd %3,x

# There is no operation that loads D with something affected by D so this
# is ok to peephole
	puls d
	pshs d
	ldd %1
=
	ldd %1

	tfr d,u
;
	tfr u,d
=
	tfr d,u

